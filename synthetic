// Task name: build_emails  (Run JavaScript)
// Depends on: get_monitors, get_synthetic_events
// Output: { emails: [{ to, subject, body, ... }], unrouted: [...] }
// The send_email task loops over `emails` and uses to / subject / body as-is.

import { execution } from '@dynatrace-sdk/automation-utils';
import { getEnvironmentUrl } from '@dynatrace-sdk/app-environment';

// ---------------- Configuration ----------------
const TEAM_TAG_KEY = 'team';        // tag Team on the HTTP monitor (key compared case-insensitively)
const CRIT_TAG_KEY = 'criticality'; // tag criticality: top-majeur | majeur | non-majeur
const ADMIN_RECIPIENTS = ['admin-observabilite@example.com'];

// Keys = values of the Team tag in UPPERCASE -> replace the example addresses
const ROUTING = {
  SPAS: ['liste-spas@example.com'],
  SPTW: ['liste-sptw@example.com'],
  SPSU: ['liste-spsu@example.com'],
  PASAT: ['liste-pasat@example.com'],
};

const CRIT_ORDER = ['TOP MAJEUR', 'MAJEUR', 'NON MAJEUR'];   // highest wins if a team has several monitors
const TZ = 'Europe/Paris';
const STEP_OFFSET = 0;                // set to 1 if dt.synthetic.step.sequence_number is 0-based on your tenant
const STEP_MATCH_WINDOW_MS = 120000;  // max gap between a failed execution and its failed step event
// ------------------------------------------------

const CRIT_ICON = { 'TOP MAJEUR': '🔴', MAJEUR: '🟠', 'NON MAJEUR': '🔵', 'NON DÉFINIE': '⚪' };

// "top-majeur" -> "TOP MAJEUR"; "majeur" -> "MAJEUR"; "non-majeur" / "non majeur" -> "NON MAJEUR"
const normalizeCrit = (v) =>
  String(v ?? '').trim().toUpperCase().replace(/[-_]+/g, ' ').replace(/\s+/g, ' ');

function toDate(v) {
  if (v === undefined || v === null || v === '') return null;
  if (typeof v === 'number') return new Date(v > 1e15 ? v / 1e6 : v); // ns or ms
  const d = new Date(v);
  return isNaN(d) ? null : d;
}

const fmtDate = (d) =>
  d ? d.toLocaleString('fr-FR', { timeZone: TZ, dateStyle: 'long', timeStyle: 'medium' }) : '';

function fmtDuration(start, end) {
  if (!start || !end) return '';
  let s = Math.max(0, Math.round((end - start) / 1000));
  const h = Math.floor(s / 3600); s -= h * 3600;
  const m = Math.floor(s / 60); s -= m * 60;
  return [h ? `${h} h` : null, m ? `${m} min` : null, `${s} s`].filter(Boolean).join(' ');
}

// Accepts tags as an array of "key:value" / "[Context]key:value" strings, an array of
// { key, value } objects, or a JSON / comma-separated string. Keys are lowercased.
function parseTags(tags) {
  let list = tags;
  if (typeof list === 'string') {
    try { list = JSON.parse(list); } catch { list = list.split(/[,;]/); }
  }
  if (!Array.isArray(list)) list = list ? [list] : [];

  const out = {};
  const add = (k, v) => {
    const key = String(k ?? '').trim().toLowerCase();
    if (key && v !== undefined && v !== null && !(key in out)) out[key] = String(v).trim();
  };
  for (const raw of list) {
    if (raw && typeof raw === 'object') {
      if ('key' in raw) add(raw.key, raw.value);
      else if (raw.stringRepresentation) add(...String(raw.stringRepresentation).replace(/^\[[^\]]*\]/, '').split(/:(.*)/s, 2));
      continue;
    }
    const t = String(raw).replace(/^\[[^\]]*\]/, '');
    const m = t.match(/^\s*([^:=]+?)\s*[:=]\s*(.+)$/);
    if (m) add(m[1], m[2]);
  }
  return out;
}

// result.status.message is a short code such as TIMEOUT
function translateCause(code, message) {
  const m = String(message ?? '');
  let cause = "Échec de l'exécution";
  if (/time.?out/i.test(m)) cause = "Délai d'attente dépassé";
  else if (/dns|resolv|unknown.?host/i.test(m)) cause = 'Résolution DNS en échec';
  else if (/ssl|tls|certific/i.test(m)) cause = 'Erreur SSL/TLS';
  else if (/refused|unreachable|connect/i.test(m)) cause = 'Connexion impossible';
  else if (/status|http|assert|validation/i.test(m)) cause = 'Réponse HTTP inattendue';
  const codeTxt = code !== undefined && code !== null ? `(code ${code})` : '';
  return { cause, detail: [m, codeTxt].filter(Boolean).join(' ') };
}

const highestCrit = (values) => CRIT_ORDER.find((c) => values.includes(c)) ?? 'NON DÉFINIE';

// Escape table-breaking characters for Markdown cells
const cell = (v) => String(v ?? '').replace(/\|/g, '\\|').replace(/\r?\n/g, ' ');

// Preferred source: dt.synthetic.http.executions metric split by location AND step.
// One row per monitor × location × failed step, with the URL taken from the step detail events.
function buildRowsFromMetric(metricRows, events, monitorIds) {
  const rows = [];
  const seen = new Set();
  const sorted = [...metricRows]
    .filter((m) => monitorIds.has(m.monitor_id))
    .sort((a, b) => String(a.location).localeCompare(String(b.location)) || Number(a.step ?? 0) - Number(b.step ?? 0));
  for (const m of sorted) {
    const key = `${m.monitor_id}|${m.location}|${m.step}`;
    if (seen.has(key)) continue; // several status messages for the same step: keep the first (most frequent first in query)
    seen.add(key);
    const hasStep = m.step !== undefined && m.step !== null;
    const detail = events
      .filter((e) => e.url && e.monitor_id === m.monitor_id && (!hasStep || String(e.step) === String(m.step)))
      .sort((a, b) => (toDate(b.timestamp)?.getTime() ?? 0) - (toDate(a.timestamp)?.getTime() ?? 0))[0];
    rows.push({
      monitor_id: m.monitor_id,
      location: m.location ?? 'Inconnue',
      step: hasStep ? Number(m.step) + STEP_OFFSET : '',
      step_name: m.step_name ?? '',
      code: m.code,
      message: m.message,
      http_status: m.http_status,
      count: m.failures,
      url: detail?.url ?? '',
    });
  }
  return rows;
}

// Latest failed monitor execution per monitor × location, with EVERY failed step of that execution
// (one row per failed step, each with its own URL)
function buildFailureRows(records, monitorIds) {
  const execs = records.filter(
    (r) => r.type === 'http_monitor_execution' && r.state === 'FAIL' && monitorIds.has(r.monitor_id),
  );
  const steps = records.filter((r) => r.type === 'http_step_execution' && r.state === 'FAIL');
  const ts = (r) => toDate(r?.timestamp)?.getTime() ?? 0;
  const closestTo = (list, ref) =>
    list
      .map((x) => ({ x, gap: Math.abs(ts(x) - ref) }))
      .filter((y) => y.gap <= STEP_MATCH_WINDOW_MS)
      .sort((a, b) => a.gap - b.gap)[0]?.x;

  const seen = new Set();
  const rows = [];
  for (const e of execs) { // records are sorted newest first
    const key = `${e.monitor_id}|${e.location}`;
    if (seen.has(key)) continue;
    seen.add(key);

    const t = ts(e);
    const details = records.filter((r) => r.url && r.monitor_id === e.monitor_id);
    const monSteps = steps.filter((s) => s.monitor_id === e.monitor_id);

    // One failed step event per step number: the one closest to this execution
    const byStep = new Map();
    for (const s of monSteps) {
      const k = s.step === undefined || s.step === null ? '?' : String(s.step);
      const cur = byStep.get(k);
      const gap = Math.abs(ts(s) - t);
      if (gap <= STEP_MATCH_WINDOW_MS && (!cur || gap < Math.abs(ts(cur) - t))) byStep.set(k, s);
    }
    const failedSteps = [...byStep.values()].sort((a, b) => Number(a.step ?? 0) - Number(b.step ?? 0));

    const base = { monitor_id: e.monitor_id, location: e.location ?? 'Inconnue' };

    if (!failedSteps.length) {
      // No step event found: execution-level result + closest URL
      rows.push({
        ...base, step: '', step_name: '', code: e.code, message: e.message,
        url: closestTo(details, t)?.url ?? '',
      });
      continue;
    }

    for (const s of failedSteps) {
      const hasStep = s.step !== undefined && s.step !== null;
      const detail =
        (hasStep ? closestTo(details.filter((d) => String(d.step) === String(s.step)), ts(s)) : undefined) ??
        (failedSteps.length === 1 ? closestTo(details, ts(s)) : undefined);
      rows.push({
        ...base,
        step: hasStep ? Number(s.step) + STEP_OFFSET : '',
        step_name: s.step_name ?? '',
        code: s.code ?? e.code,
        message: s.message ?? e.message,
        url: detail?.url ?? '',
      });
    }
  }
  return rows;
}

function buildBody(it) {
  const closed = it.status === 'CLOSED';
  const L = [];

  L.push('**ALERTE MONITORING SYNTHÉTIQUE • DYNATRACE**');
  L.push('');
  L.push(closed
    ? `# 🟢 Rétablissement du service ${it.team}`
    : `# 🔴 Indisponibilité détectée sur le service ${it.team}`);
  L.push('');
  L.push(`**Criticité :** ${CRIT_ICON[it.criticite] ?? '⚪'} ${it.criticite}  |  **Statut :** ${closed ? '🟢 RÉSOLU' : '🔴 OUVERT'}`);
  L.push('');
  L.push('---');
  L.push('');
  L.push("## Résumé de l'incident");
  L.push('');
  L.push('| Élément | Valeur |');
  L.push('|---|---|');
  L.push(`| Moniteur | **${cell(it.monitor)}** |`);
  L.push(`| Équipe concernée | **${cell(it.team)}** |`);
  L.push('| Catégorie | **Disponibilité** |');
  const uniq = (arr) => [...new Set(arr.filter((x) => x !== undefined && x !== null && x !== ''))];
  const locations = uniq(it.failures.map((f) => f.location));
  const steps = uniq(it.failures.map((f) => f.step));
  L.push(`| Localisation en échec | **${cell(locations.join(', ') || 'Non disponible')}** |`);
  L.push(`| Step en erreur | **${cell(steps.join(', ') || 'Non disponible')}** |`);
  L.push(`| Début de l'incident | **${cell(it.start)}** (heure de Paris) |`);
  if (closed) {
    L.push(`| Fin de l'incident | **${cell(it.end)}** (heure de Paris) |`);
    L.push(`| Durée totale | **${cell(it.duration)}** |`);
  }
  if (it.problemTitle) L.push(`| Titre du problème | ${cell(it.problemTitle)} |`);
  L.push(`| Cause racine (dernier échec) | **${cell(it.rootCause || 'Non identifiée')}** |`);
  L.push(`| Problème Dynatrace | [${cell(it.problemId)}](${it.problemUrl}) |`);
  L.push('');
  L.push(`**[➜ Accéder au problème dans Dynatrace](${it.problemUrl})**`);
  L.push('');

  L.push('---');
  L.push('');
  L.push('_Ce message est généré automatiquement par Dynatrace. Merci de ne pas y répondre._');
  return L.join('\n');
}

export default async function ({ execution_id }) {
  const ex = await execution(execution_id);
  const event = ex.params.event;

  const monitors = (await ex.result('get_monitors'))?.records ?? [];
  const synth = (await ex.result('get_synthetic_events'))?.records ?? [];
  let metricRows = [];
  try { metricRows = (await ex.result('get_failed_steps'))?.records ?? []; } catch { metricRows = []; }

  const status = event['event.status'] === 'CLOSED' ? 'CLOSED' : 'OPEN';
  const start = toDate(event['event.start']);
  const end = status === 'CLOSED' ? toDate(event['event.end']) : null;

  // Label = display ID (P-…). Link = event.id, whatever format this Workflows version returns
  // (internal ID on older versions, P-… since 1.3537.6) – both are what the Problems app expects.
  const problemId = event['display_id'] ?? event['event.id'] ?? '';

  // Root cause found by Davis (may be empty while the analysis is still running)
  // root_cause_entity_* are deprecated in favour of root_cause.smartscape_entity, still populated today
  const rcName = event['root_cause_entity_name'] ?? event['root_cause.smartscape_entity.name'] ?? '';
  const rcId = event['root_cause_entity_id'] ?? event['root_cause.smartscape_entity'] ?? '';
  const rootCause = rcName || rcId ? [rcName, rcId && rcId !== rcName ? `(${rcId})` : ''].filter(Boolean).join(' ') : '';
  const problemTitle = event['event.name'] ?? '';
  const problemUrl =
    `${getEnvironmentUrl().replace(/\/$/, '')}/ui/apps/dynatrace.davis.problems/problem/${encodeURIComponent(event['event.id'] ?? problemId)}`;

  // Monitors in the problem but not returned by get_monitors (deleted, no access...)
  const httpIds = (event['affected_entity_ids'] ?? []).filter((id) => String(id).startsWith('HTTP_CHECK-'));
  const known = new Set(monitors.map((m) => m.id));
  const missing = httpIds.filter((id) => !known.has(id)).map((id) => ({ id, name: id, tags: [] }));

  const eventTags = parseTags(event['entity_tags']);

  // ---- Group monitors by recipient team ----
  const groups = {};
  const unrouted = [];

  for (const mon of [...monitors, ...missing]) {
    // Entity tags first, then primary tags seen on the synthetic events of this monitor
    const tags = parseTags(mon.tags);
    const pt = synth.find((r) => r.monitor_id === mon.id && (r.pt_team || r.pt_crit));
    if (!tags[TEAM_TAG_KEY] && pt?.pt_team) tags[TEAM_TAG_KEY] = String(pt.pt_team);
    if (!tags[CRIT_TAG_KEY] && pt?.pt_crit) tags[CRIT_TAG_KEY] = String(pt.pt_crit);
    // Last resort: tags carried by the problem event itself (entity_tags of the affected entities)
    if (!tags[TEAM_TAG_KEY] && eventTags[TEAM_TAG_KEY]) tags[TEAM_TAG_KEY] = eventTags[TEAM_TAG_KEY];
    if (!tags[CRIT_TAG_KEY] && eventTags[CRIT_TAG_KEY]) tags[CRIT_TAG_KEY] = eventTags[CRIT_TAG_KEY];
    const teamTag = tags[TEAM_TAG_KEY];
    const recipients = teamTag ? ROUTING[teamTag.toUpperCase()] : undefined;
    const routed = Array.isArray(recipients) && recipients.length > 0;

    if (!routed) unrouted.push({ id: mon.id, monitor: mon.name, team: teamTag ?? null });

    const key = routed ? teamTag.toUpperCase() : '__ADMIN__';
    groups[key] ??= { to: routed ? recipients : ADMIN_RECIPIENTS, teams: new Set(), monitors: [] };
    groups[key].teams.add(teamTag || 'NON DÉFINIE');
    groups[key].monitors.push({ id: mon.id, name: mon.name, crit: normalizeCrit(tags[CRIT_TAG_KEY]) });
  }

  // ---- One email per group ----
  const emails = Object.values(groups).map((g) => {
    const ids = new Set(g.monitors.map((m) => m.id));
    const multi = g.monitors.length > 1;
    const nameById = Object.fromEntries(g.monitors.map((m) => [m.id, m.name]));

    const fromMetric = buildRowsFromMetric(metricRows, synth, ids);
    const rawRows = fromMetric.length ? fromMetric : buildFailureRows(synth, ids);
    const failures = rawRows.map((r) => {
      const t = translateCause(r.code, r.message);
      const cause = t.cause;
      const detail = [t.detail, r.http_status ? `HTTP ${r.http_status}` : '', r.count ? `${r.count} échec(s)` : '']
        .filter(Boolean).join(' · ');
      return {
        location: multi ? `${r.location} — ${nameById[r.monitor_id]}` : r.location,
        step: r.step_name ? `${r.step} — ${r.step_name}` : r.step,
        url: r.url,
        cause,
        detail,
      };
    });

    // Header URL: first failing URL if any, else any URL seen for these monitors
    const url = failures.find((f) => f.url)?.url ?? synth.find((r) => ids.has(r.monitor_id) && r.url)?.url ?? '';
    // Root cause = last failed result (most recent failed step, else failed execution) for these monitors
    const lastFail = synth
      .filter((r) => ids.has(r.monitor_id) && r.state === 'FAIL' && (r.code != null || r.message))
      .sort((a, b) => {
        const d = (toDate(b.timestamp)?.getTime() ?? 0) - (toDate(a.timestamp)?.getTime() ?? 0);
        return d || (a.type === 'http_step_execution' ? -1 : 1); // same time: prefer the step event
      })[0];
    const lastSrc = lastFail ?? rawRows[0];
    let lastFailure = '';
    if (lastSrc) {
      const tc = translateCause(lastSrc.code, lastSrc.message);
      const when = lastFail ? fmtDate(toDate(lastFail.timestamp)) : '';
      const stepTxt = lastSrc.step !== undefined && lastSrc.step !== null && lastSrc.step !== ''
        ? `step ${lastFail ? Number(lastSrc.step) + STEP_OFFSET : lastSrc.step}` : '';
      const ctx = [lastSrc.location, stepTxt, when].filter(Boolean).join(', ');
      lastFailure = `${tc.cause} — ${tc.detail}${ctx ? ` (${ctx})` : ''}`;
    }

    // Monitor URL = URL of its first step (lowest step number seen in the detail events)
    const monitorUrl =
      synth
        .filter((r) => ids.has(r.monitor_id) && r.url)
        .sort((a, b) => Number(a.step ?? 1e9) - Number(b.step ?? 1e9))[0]?.url ?? '';

    const item = {
      to: g.to,
      team: [...g.teams].join(', '),
      monitor: g.monitors.map((m) => m.name).join(', '),
      url,
      monitorUrl,
      criticite: highestCrit(g.monitors.map((m) => m.crit)),
      status,
      start: fmtDate(start),
      end: fmtDate(end),
      duration: fmtDuration(start, end),
      problemId,
      problemUrl,
      problemTitle,
      rootCause: lastFailure,
      failures,
    };

    item.subject =
      `${status === 'CLOSED' ? 'Rétablissement du service' : 'Indisponibilité'} – ${item.team} – ${item.monitor}`;
    item.body = buildBody(item);
    return item;
  });

  // The To field of the email task takes each {{ }} entry as ONE address (a list is rendered as text
  // and rejected). So we send one email per recipient: `to` is a plain string here.
  const sends = emails.flatMap((e) => e.to.map((address) => ({ ...e, to: String(address).trim() })));

  // Diagnostic: what came back from get_synthetic_events (visible in the task Result)
  const debug = {
    records: synth.length,
    byType: synth.reduce((acc, r) => ({ ...acc, [r.type ?? 'null']: (acc[r.type ?? 'null'] ?? 0) + 1 }), {}),
    failedSteps: synth.filter((r) => r.type === 'http_step_execution' && r.state === 'FAIL').length,
    withUrl: synth.filter((r) => r.url).length,
    metricRows: metricRows.length,
    withStep: synth.filter((r) => r.step !== undefined && r.step !== null).length,
    monitorsFromQuery: monitors.map((m) => ({ id: m.id, name: m.name, tags: m.tags })),
    monitorsMissing: missing.map((m) => m.id),
    eventEntityTags: event['entity_tags'] ?? null,
  };

  return { emails: sends, unrouted, debug };
}
